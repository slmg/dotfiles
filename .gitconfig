[user]
	name = slmg
	email = slmg.code@gmail.com
[alias]
	a = add
	au = add --update
	b = branch
	ci = commit -v
	cia = commit -v -a
	cim = commit -m
	ciam = commit -m -a
	cl = clone --recurse-submodules
	co = checkout
	cob = checkout -b
	d = diff
	dc = diff --cached
	f = fetch
	h = help
	l = pull
	lo = log --oneline --decorate --graph
	lov = log --graph
	ls = ls-files
	m = merge
	p = push
	pu = push -u
	rb = rebase
	rbi = rebase -i
	rs = reset
	rv = remote -v
	s = status
	sta = stash
[includeIf "gitdir:~/src/gitlab/"]
	path = ~/src/gitlab/.gitconfig-gitlab
[fetch]
	prune = true
[core]
	autocrlf = input
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[safe]
	directory = /snap/microk8s/current/addons/community/.git
[init]
	defaultBranch = main
